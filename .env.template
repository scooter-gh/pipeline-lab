# Copy this file to .env and fill in real values before running make up
# .env is gitignored and must never be committed

# GitHub PAT — used to auto-generate runner registration tokens
# Requires repo Administration: Read and Write
GITHUB_PAT=REPLACE_WITH_PERSONAL_ACCESS_TOKEN

# GitHub identity
GITHUB_OWNER=REPLACE_WITH_YOUR_GITHUB_USERNAME
GITHUB_REPO=pipeline-lab

# MiniStack config — these are correct as-is for local dev, do not change
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
MINISTACK_ENDPOINT=http://ministack:4566